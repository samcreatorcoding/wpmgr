def _color(colorstr:str):
    if "#" in colorstr:
        i = colorstr.index("#")
        c = colorstr[i+1:i+6]
    else:
        c = colorstr[:6]
    c = c.lower()
    nc = c
    for i, _c in enumerate(c):
        if _c not in "0123456789abcdef":
            print(f"! {c[i]} is invalid for hex color and replaced with 'f'")
            nc = nc[:i]+"f"+nc[i+1:]
    while not len(nc) >= 6:
        nc += "f"
    return "#"+nc

def main():
    config = Settings()

    if len(argv) >= 2:
        action = argv[1].lower()
    else:
        action = "next"

    if action == "setup":
        color = "#ffffff" if len(argv) < 3 else _color(argv[2])
        create_desktop_icons(color)
        return

    try:
        engine = Engine(config)
    except NoWallpapers as e:
        print(f"Error: {e}")
        return
    
    if action == "next":
        engine.next()
    elif action == "prev":
        engine.prev()
    elif action == "clear":
        engine.clear()
    elif action == "rand":
        engine.rand()
    else:
        print("OPTIONS:\n  rand  - random wallpaper\n  next  - next wallpaper\n  prev  - previous wallpaper\n  clear - clear wallpaper history\n  setup - create desktop icons for these commands")
        return
    
    engine.persist.dump()

if __name__ == "__main__":
    main()
