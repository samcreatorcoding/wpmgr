#!/usr/bin/python3

from pathlib import Path
from random import randint
from json import dump, load
from urllib.parse import quote
from subprocess import run
from shlex import split
from sys import argv

# --- settings ---
SETFILE = Path.home() / ".wpmgr-settings"

class Settings:
    def __init__(self):
        try:
            with open(SETFILE, "r") as s:
                data = load(s)
        except Exception:
            data = {}

        self.hlen = data.get("history_length", 20)
        self.wpfolder = Path(data.get("wallpaper_folder", "~/Desktop/Wallpapers")).expanduser()
        self.pfile = self.wpfolder / ".persist"
        self.exts = data.get("wallpaper_file_extensions")
        self._urisafe = data.get("set_commands_require_uri_safe", True)
        if not isinstance(self.exts, list):
            self.exts = ["jpg", "jpeg", "png", "webp"]
        self.cmds = data.get("wallpaper_set_commands_%P_as_wallpaper_full_path")
        if not isinstance(self.cmds, list):
            self.cmds = ["gsettings set org.gnome.desktop.background picture-uri-dark file://%P", "gsettings set org.gnome.desktop.background picture-uri file://%P"]

        with open(SETFILE, "w") as s:
            dump({
                "history_length":self.hlen,
                "wallpaper_folder":str(self.wpfolder),
                "wallpaper_file_extensions":self.exts,
                "wallpaper_set_commands_%P_as_wallpaper_full_path":self.cmds,
                "set_commands_require_uri_safe":self._urisafe
            }, s, indent=4)

# --- persistence ---
class Persistence:
    def __init__(self, settings: Settings, folder: Path):
        hlen = settings.hlen if isinstance(settings.hlen, int) else 1
        self.hlen = max(hlen, 1)
        self.pfile = settings.pfile
        self.history = []
        self.future = []
        
        # calculate folder modification time safely
        self._load_data()

    def _load_data(self):
        if not self.pfile.is_file():
            return
        try:
            with open(self.pfile, "r") as s:
                data = load(s)
            
            self.history = [Path(p) for p in data.get("h", [])]
            self.future = [Path(p) for p in data.get("f", [])]
        except Exception:
            pass # fallback to empty states if JSON is corrupted

    def dump(self):
        data = {
            "f": [str(p) for p in self.future],
            "h": [str(p) for p in self.history[-self.hlen:]]
        }
        with open(self.pfile, "w") as s:
            dump(data, s, indent=4)

class NoWallpapers(Exception): pass

# --- engine ---
class Engine:
    def __init__(self, settings: Settings):
        self.settings = settings
        self.wpfolder = settings.wpfolder
        self.wpfolder.mkdir(parents=True, exist_ok=True)
            
        self.wps = self._get_wps()
        if not self.wps:
            raise NoWallpapers(f"No wallpapers found in {self.wpfolder}")
            
        # initialize persistence after files are parsed
        self.persist = Persistence(settings, self.wpfolder)

        available = set(self.wps)
        self.persist.history = [
            p for p in self.persist.history
            if p in available
        ]
        self.persist.future = [
            p for p in self.persist.future
            if p in available
        ]

    def _get_wps(self) -> list[Path]:
        wps = {
            p.resolve()
            for ext in self.settings.exts
            for p in self.wpfolder.rglob(f"*.{ext}")
        }
        return sorted(wps, key=lambda p: str(p).casefold())

    def setwp(self, wp: Path):
        if not wp.is_file():
            return
        for cmd_template in self.settings.cmds:
            if self.settings._urisafe:
                _wp = quote(str(wp), safe="/")
            else:
                _wp = f"'{wp}'"
            exec_cmd = cmd_template.replace("%P", _wp)
            run(split(exec_cmd))

    def next(self):
        _p = self.persist
        if _p.future:
            i = _p.future.pop(0)
        else:
            # fallback if history is empty
            if _p.history:
                last_i = _p.history[-1]
                if last_i in self.wps:
                    _i = (self.wps.index(last_i) + 1) % len(self.wps)
                    i = self.wps[_i]
                else:
                    i = self.wps[0]
            else:
                i = self.wps[0]
                
        _p.history.append(i)
        self.setwp(i)
    
    def prev(self):
        _p = self.persist
        if len(_p.history) <= 1:
            return  # no older wallpaper to step back to
            
        current = _p.history.pop(-1)
        _p.future.insert(0, current)  # prepend back into future list
        
        # display the previous wallpaper remaining in history
        i = _p.history[-1]
        self.setwp(i)
    
    def rand(self):
        _p = self.persist
        _p.future.clear()
        if len(self.wps) == 1:
            i = self.wps[0]
        elif _p.history:
            current = _p.history[-1]
            choices = [p for p in self.wps if p != current]
            i = choices[randint(0, len(choices) - 1)]
        else:
            i = self.wps[randint(0, len(self.wps) - 1)]
        _p.history.append(i)
        self.setwp(i)

    def clear(self):
        self.persist.history.clear()
        self.persist.future.clear()

